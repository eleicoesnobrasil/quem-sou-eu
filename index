  document.getElementById("quiz").classList.remove("hidden");

  renderQuestion();
  window.scrollTo({top:0, behavior:"smooth"});
}

function renderQuestion() {
  const q = shuffledQuestions[current];
  const total = shuffledQuestions.length;
  const progress = Math.round(((current + 1) / total) * 100);

  document.getElementById("questionCount").textContent =
    `PERGUNTA ${current + 1} DE ${total}`;

  document.getElementById("progressPercent").textContent =
    progress + "%";

  document.getElementById("progressFill").style.width =
    progress + "%";

  document.getElementById("questionEmoji").textContent = q.emoji;
  document.getElementById("questionText").textContent = q.text;

  const answersBox = document.getElementById("answers");
  answersBox.innerHTML = "";

  q.answers.forEach((answer, index) => {
    const button = document.createElement("button");
    button.className = "answer";
    button.type = "button";

    button.setAttribute(
      "aria-pressed",
      String(selected[current] === answer[0])
    );

    const letter = document.createElement("span");
    letter.className = "letter";
    letter.textContent = String.fromCharCode(65 + index);

    const label = document.createElement("span");
    label.textContent = answer[1];

    button.append(letter, label);

    button.addEventListener("click", () => {
      selected[current] = answer[0];
      renderQuestion();
    });

    answersBox.appendChild(button);
  });

  const backBtn = document.getElementById("backBtn");
  backBtn.disabled = current === 0;
  backBtn.style.opacity = current === 0 ? ".45" : "1";

  const nextBtn = document.getElementById("nextBtn");
  nextBtn.disabled = selected[current] === undefined;

  nextBtn.textContent =
    current === total - 1 ? "Ver resultado! 🎉" : "Próxima →";
}

function previousQuestion() {
  if (current > 0) {
    current--;
    renderQuestion();
  }
}

function nextQuestion() {
  if (selected[current] === undefined) return;

  if (current < shuffledQuestions.length - 1) {
    current++;
    renderQuestion();
  } else {
    showResult();
  }
}

function showResult() {
  const scores = {lula:0, fhc:0, collor:0, flavio:0};

  Object.values(selected).forEach(candidate => {
    scores[candidate]++;
  });

  const maxScore = Math.max(...Object.values(scores));
  const winners = Object.keys(scores).filter(
    key => scores[key] === maxScore
  );

  const winner = winners[Math.floor(Math.random() * winners.length)];
  const profile = candidates[winner];

  document.getElementById("quiz").classList.add("hidden");
  document.getElementById("result").classList.remove("hidden");

  const resultPhoto = document.getElementById("resultPhoto");

  if (winners.length === 1 && profile.image) {
    resultPhoto.src = profile.image;
    resultPhoto.alt = "Foto de " + profile.short;
    resultPhoto.classList.remove("hidden");

    resultPhoto.onerror = function() {
      this.classList.add("hidden");
    };
  } else {
    resultPhoto.classList.add("hidden");
    resultPhoto.removeAttribute("src");
  }

  document.getElementById("resultName").textContent =
    winners.length > 1
      ? "Empate entre perfis!"
      : profile.personality;

  document.getElementById("profileTitle").textContent =
    winners.length > 1
      ? "SEUS RESULTADOS POLÍTICOS"
      : profile.title;

  document.getElementById("profileDescription").textContent =
    winners.length > 1
      ? winners.map(k => candidates[k].title + "\n\n" + candidates[k].description).join("\n\n——————————\n\n")
      : profile.description;

  const scoreBars = document.getElementById("scoreBars");
  scoreBars.innerHTML = "";

  const sorted = Object.keys(scores).sort(
    (a, b) => scores[b] - scores[a]
  );

  sorted.forEach(key => {
    const c = candidates[key];
    const percent = Math.round(
      scores[key] / shuffledQuestions.length * 100
    );

    const row = document.createElement("div");
    row.className = "score-row";

    const label = document.createElement("div");
    label.className = "score-label";

    const name = document.createElement("span");
    name.textContent = c.short;

    const value = document.createElement("span");
    value.textContent =
      `${percent}% (${scores[key]} de ${shuffledQuestions.length})`;

    label.append(name, value);

    const track = document.createElement("div");
    track.className = "score-track";

    const fill = document.createElement("div");
    fill.className = "score-fill";
    fill.style.width = percent + "%";
    fill.style.background = c.color;

    track.appendChild(fill);
    row.append(label, track);
    scoreBars.appendChild(row);
  });

  window.scrollTo({top:0, behavior:"smooth"});
}

function restartQuiz() {
  document.getElementById("result").classList.add("hidden");
  document.getElementById("intro").classList.remove("hidden");
  window.scrollTo({top:0, behavior:"smooth"});
}

async function shareResult() {
  const resultName =
    document.getElementById("resultName").textContent;

  const text =
    `Fiz o quiz "${quizTitle}" e meu resultado foi: ${resultName} 😂🇧🇷 Faça o teste também!`;

  if (navigator.share) {
    try {
      await navigator.share({
        title: quizTitle,
        text: text
      });
    } catch (error) {
      if (error.name !== "AbortError") {
        copyResult(text);
      }
    }
  } else {
    copyResult(text);
  }
}

async function copyResult(text) {
  try {
    await navigator.clipboard.writeText(text);
    alert("Resultado copiado! Agora é só colar onde quiser. 🎉");
  } catch {
    window.prompt("Copie seu resultado:", text);
  }
}
</script>
